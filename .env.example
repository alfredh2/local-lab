# LocalLab configuration (copy to .env)
LOCALLAB_DATA_DIR=./data
LOCALLAB_DATABASE_URL=sqlite:///./data/locallab.db
LOCALLAB_API_HOST=127.0.0.1
LOCALLAB_API_PORT=8321
LOCALLAB_CORS_ORIGINS=["http://localhost:3210","http://127.0.0.1:3210"]
LOCALLAB_LOG_LEVEL=INFO
LOCALLAB_LOG_JSON=false
LOCALLAB_HF_CACHE_DIR=~/.cache/huggingface/hub
LOCALLAB_OLLAMA_URL=http://127.0.0.1:11434
LOCALLAB_ALLOWED_RUNTIME_HOSTS=["127.0.0.1","localhost","::1"]
LOCALLAB_WORKER_POLL_S=1.0
LOCALLAB_WORKER_STALE_S=30
# Frontend
# Leave unset: the browser uses same-origin /api, proxied by Next to LOCALLAB_API_INTERNAL_URL (default http://127.0.0.1:8321)
# NEXT_PUBLIC_API_URL=
